{
  "manifest_version": 3,
  "name": "UnQuesti",
  "version": "1.5.0",
  "description": "UnQuesti — plan je lesweken in Questi: lesfiches slepen, lesdoelen, afdrukken en één controle voor alles naar Questi gaat.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.questi.com/*",
    "*://questi.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "UnQuesti (Alt+P)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-planner": {
      "suggested_key": {
        "default": "Alt+P"
      },
      "description": "UnQuesti openen of sluiten"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.questi.com/*",
        "*://questi.com/*"
      ],
      "js": [
        "planner.js",
        "lessons.js",
        "methodes.js",
        "settings.js",
        "content.js"
      ],
      "css": [
        "planner.css",
        "lessons.css",
        "methodes.css",
        "settings.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.questi.com/*",
        "*://questi.com/*"
      ],
      "js": [
        "opstap-bridge.js"
      ],
      "world": "MAIN",
      "run_at": "document_start"
    }
  ]
}
