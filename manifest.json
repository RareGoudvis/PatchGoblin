{
  "manifest_version": 3,
  "name": "UnQuesti BETA",
  "version": "1.3.0",
  "description": "BETA — UnQuesti, de opvolger van de Questi Week Planner. Naast de stabiele versie te installeren; gebruik er niet beide tegelijk.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.questi.com/*",
    "*://questi.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "UnQuesti BETA (Alt+Shift+P)",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-planner": {
      "suggested_key": {
        "default": "Alt+Shift+P"
      },
      "description": "Toggle UnQuesti BETA"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.questi.com/*",
        "*://questi.com/*"
      ],
      "js": [
        "planner.js",
        "lessons.js",
        "methodes.js",
        "settings.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "version_name": "1.3.0 beta 1"
}
